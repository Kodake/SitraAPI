{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=RPOS;Integrated Security=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CsvUpload": {
    "MaxFileRecords": 200,
    "ValidFileType": "text/csv",
    "ProductFileName": "Products.csv",
    "ServiceFileName": "Services.csv"
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Audiences": [
          "http://localhost:5001",
          "http://localhost:5000"
        ],
        "Issuer": "dotnet-user-jwts"
      }
    }
  }
}